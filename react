function TeamHubScreen() {
  const [tab, setTab] = useState<"timeoff" | "announcements" | "docs">("timeoff");
  const [requests, setRequests] = useState(mock.hub.timeOff);

  function updateStatus(id: string, status: "approved" | "denied") {
    setRequests((prev) => prev.map((r) => (r.id === id ? { ...r, status } : r)));
  }

  return (
    <SafeAreaView style={styles.safe}>
      <ScrollView contentContainerStyle={styles.container}>
        <Header />

        <Card>
          <SectionTitle title="Team Hub" right={<Badge label="Centralized" tone="emerald" />} />

          <View style={styles.segment}>
            {[
              { key: "timeoff", label: "Time off" },
              { key: "announcements", label: "Updates" },
              { key: "docs", label: "Docs" },
            ].map((t) => {
              const active = tab === (t.key as any);
              return (
                <TouchableOpacity
                  key={t.key}
                  onPress={() => setTab(t.key as any)}
                  style={[styles.segmentItem, active && { backgroundColor: COLORS.card }]}
                >
                  <Text style={[styles.segmentText, active && { color: COLORS.text }]}>{t.label}</Text>
                </TouchableOpacity>
              );
            })}
          </View>

          {tab === "timeoff" ? (
            <View style={{ gap: 10 }}>
              {requests.map((r) => (
                <View key={r.id} style={styles.requestCard}>
                  <View style={styles.rowBetween}>
                    <View>
                      <Text style={styles.shiftName}>{r.name}</Text>
                      <Text style={styles.smallMuted}>
                        {r.dates} • {r.reason}
                      </Text>
                    </View>
                    <Badge
                      label={r.status.toUpperCase()}
                      tone={r.status === "pending" ? "slate" : r.status === "approved" ? "emerald" : "red"}
                    />
                  </View>

                  {r.status === "pending" ? (
                    <View style={styles.btnRow}>
                      <TouchableOpacity style={[styles.primaryBtn, { flex: 1 }]} onPress={() => updateStatus(r.id, "approved")}>
                        <Text style={styles.primaryBtnText}>Approve</Text>
                      </TouchableOpacity>
                      <TouchableOpacity style={[styles.secondaryBtn, { flex: 1 }]} onPress={() => updateStatus(r.id, "denied")}>
                        <Text style={styles.secondaryBtnText}>Deny</Text>
                      </TouchableOpacity>
                    </View>
                  ) : null}
                </View>
              ))}
            </View>
          ) : null}

          {tab === "announcements" ? (
            <View style={{ gap: 10 }}>
              {mock.hub.announcements.map((m) => (
                <View key={m.id} style={styles.requestCard}>
                  <Text style={styles.shiftName}>{m.title}</Text>
                  <Text style={styles.alertDetail}>{m.body}</Text>
                </View>
              ))}
            </View>
          ) : null}

          {tab === "docs" ? (
            <View style={{ gap: 10 }}>
              {mock.hub.docs.map((d) => (
                <View key={d} style={styles.requestCard}>
                  <Text style={styles.shiftName}>{d}</Text>
                  <Text style={styles.smallMuted}>Team document</Text>
                </View>
              ))}
            </View>
          ) : null}

          <Divider />
          <Text style={styles.footerNote}>
            Founders: Alex Vartanian • Sarah Lima • Will Kaufmann • Mackenzie Wright
          </Text>
        </Card>
      </ScrollView>
    </SafeAreaView>
  );
}


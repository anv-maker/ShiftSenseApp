function TimecardsScreen() {
  const [mode, setMode] = useState("regular");
  const [audited, setAudited] = useState(false);

  const filtered = useMemo(() => {
    return mock.timecards.filter((e) => {
      if (mode === "regular") return true;
      if (mode === "overtime") return e.overtimeRisk;
      return e.discrepancies > 0;
    });
  }, [mode]);

  return (
    <SafeAreaView style={styles.safe}>
      <ScrollView contentContainerStyle={styles.container}>
        <Header />
        <Card>
          <SectionTitle
            title="Timecards & Overtime"
            right={
              <TouchableOpacity style={styles.primaryBtn} onPress={() => setAudited(true)}>
                <Text style={styles.primaryBtnText}>Auto-check</Text>
              </TouchableOpacity>
            }
          />
          <Text style={styles.smallMuted}>Auto-optimize timesheets from Square timecards.</Text>

          <View style={styles.segment}>
            {[
              { key: "regular", label: "Regular" },
              { key: "overtime", label: "Overtime" },
              { key: "discrepancies", label: "Discrepancies" },
            ].map((t) => {
              const active = mode === t.key;
              return (
                <TouchableOpacity
                  key={t.key}
                  onPress={() => setMode(t.key)}
                  style={[styles.segmentItem, active && { backgroundColor: COLORS.card }]}
                >
                  <Text style={styles.segmentText}>{t.label}</Text>
                </TouchableOpacity>
              );
            })}
          </View>

          {audited ? (
            <View style={styles.auditBanner}>
              <Text style={styles.auditTitle}>Audit complete</Text>
              <Text style={styles.auditText}>Found 3 potential issues: 2 overtime risks, 1 missing break.</Text>
            </View>
          ) : null}

          <FlatList
            data={filtered}
            keyExtractor={(i) => i.id}
            scrollEnabled={false}
            renderItem={({ item }) => (
              <View>
                <View style={styles.timecardRow}>
                  <View style={{ flex: 1 }}>
                    <View style={styles.rowGap}>
                      <Text style={styles.shiftName}>{item.name}</Text>
                      <Text style={styles.smallMuted}>{item.hours.toFixed(1)}h</Text>
                      {item.overtimeRisk ? <Badge label="OT Risk" tone="amber" /> : null}
                      {item.discrepancies > 0 ? <Badge label={`${item.discrepancies} issues`} tone="red" /> : null}
                    </View>
                    {!item.overtimeRisk && item.discrepancies === 0 ? (
                      <Text style={[styles.smallMuted, { marginTop: 4 }]}>No issues detected</Text>
                    ) : null}
                  </View>
                </View>
                <Divider />
              </View>
            )}
          />
          <Text style={styles.footerNote}>
            Direct Square sync via Square Labor API and roles via Square Team API.
          </Text>
        </Card>
      </ScrollView>
    </SafeAreaView>
  );
}


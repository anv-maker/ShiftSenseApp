// Simple “mini chart” (no external chart lib): bars for sales vs labor
function MiniBars({ data }: { data: { t: string; sales: number; labor: number }[] }) {
  const max = useMemo(() => Math.max(...data.map((d) => Math.max(d.sales, d.labor))), [data]);
  return (
    <View style={styles.miniChartWrap}>
      {data.map((d) => {
        const salesH = Math.round((d.sales / max) * 46);
        const laborH = Math.round((d.labor / max) * 46);
        return (
          <View key={d.t} style={styles.miniBarCol}>
            <View style={[styles.miniBar, { height: salesH, backgroundColor: COLORS.emerald }]} />
            <View style={[styles.miniBar, { height: laborH, backgroundColor: "#94A3B8" }]} />
            <Text style={styles.miniBarLabel}>{d.t}</Text>
          </View>
        );
      })}
    </View>
  );
}


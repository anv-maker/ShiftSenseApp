function TeamHubScreen() {
  const [tab, setTab] = useState("timeoff");
  const [requests, setRequests] = useState(mock.hub.timeOff);

  function updateStatus(id, status) {
    setRequests((prev) => prev.map((r) => (r.id === id ? { ...r, status } : r)));
  }

  return (
    <SafeAreaView style={styles.safe}>
      <ScrollView contentContainerStyle={styles.container}>
        <Header />
        <Card>
          <SectionTitle title="Team Hub" />

          <View style={styles.segment}>
            {[
              { key: "timeoff", label: "Time off" },
              { key: "announcements", label: "Updates" },
              { key: "docs", label: "Docs" },
            ].map((t) => {
              const active = tab === t.key;
              return (
                <TouchableOpacity
                  key={t.key}
                  onPress={() => setTab(t.key)}
                  style={[styles.segmentItem, active && { backgroundColor: COLORS.card }]}
                >
                  <Text style={styles.segmentText}>{t.label}</Text>
                </TouchableOpacity>
              );
            })}
          </View>

          {tab === "timeoff" ? (
            <View>
              {requests.map((r) => (
                <View key={r.id} style={styles.requestCard}>
                  <View style={styles.rowBetween}>
                    <View>
                      <Text style={styles.shiftName}>{r.name}</Text>
                      <Text style={styles.smallMuted}>{r.dates} • {r.reason}</Text>
                    </View>
                    <Badge
                      label={r.status === "approved" ? "Approved" : r.status === "denied" ? "Denied" : "Pending"}
                      tone={r.status === "approved" ? "emerald" : r.status === "denied" ? "red" : "slate"}
                    />
                  </View>
                  {r.status === "pending" ? (
                    <View style={styles.btnRow}>
                      <TouchableOpacity style={styles.primaryBtn} onPress={() => updateStatus(r.id, "approved")}>
                        <Text style={styles.primaryBtnText}>Approve</Text>
                      </TouchableOpacity>
                      <TouchableOpacity style={styles.secondaryBtn} onPress={() => updateStatus(r.id, "denied")}>
                        <Text style={styles.secondaryBtnText}>Deny</Text>
                      </TouchableOpacity>
                    </View>
                  ) : null}
                </View>
              ))}
            </View>
          ) : null}

          {tab === "announcements" ? (
            <View>
              {mock.hub.announcements.map((m) => (
                <View key={m.id} style={styles.requestCard}>
                  <Text style={styles.shiftName}>{m.title}</Text>
                  <Text style={styles.smallMuted}>{m.body}</Text>
                </View>
              ))}
            </View>
          ) : null}

          {tab === "docs" ? (
            <View>
              {mock.hub.docs.map((d) => (
                <View key={d} style={styles.requestCard}>
                  <Text style={styles.shiftName}>{d}</Text>
                  <Text style={styles.smallMuted}>Team document</Text>
                </View>
              ))}
            </View>
          ) : null}

          <Text style={styles.aboutFounders} style={{ marginTop: 12, fontSize: 11, color: COLORS.muted }}>
            Founders: Alex Vartanian • Sarah Lima • Will Kaufmann • Mackenzie Wright
          </Text>
        </Card>
      </ScrollView>
    </SafeAreaView>
  );
}

